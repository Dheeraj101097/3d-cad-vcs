# Local dev: leave VITE_API_URL blank — Vite proxy (vite.config.js) forwards /api to localhost:5000
# Production: set VITE_API_URL in Vercel's Environment Variables (Settings → Environment Variables)
#   Example: VITE_API_URL=https://3d-cad-vcs-production.up.railway.app
# To change the backend URL: update the value in Vercel and trigger a redeploy. No code changes needed.
VITE_API_URL=
